{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [
        {
          "slug": "accent-satin",
          "name": "Accent Satin",
          "gradient": "linear-gradient(135deg, #4c6547 0%, #41593c 100%)"
        }
      ],
      "palette": [
        {
          "slug": "background",
          "color": "#faf9f4",
          "name": "Background"
        },
        {
          "slug": "surface",
          "color": "#f4f4ee",
          "name": "Surface"
        },
        {
          "slug": "surface-alt",
          "color": "#ffffff",
          "name": "Surface Alt"
        },
        {
          "slug": "surface-tint",
          "color": "#e0e3df",
          "name": "Surface Tint"
        },
        {
          "slug": "text",
          "color": "#2f342d",
          "name": "Text"
        },
        {
          "slug": "muted",
          "color": "#5c6058",
          "name": "Muted"
        },
        {
          "slug": "accent",
          "color": "#4c6547",
          "name": "Accent"
        },
        {
          "slug": "accent-dim",
          "color": "#41593c",
          "name": "Accent Dim"
        },
        {
          "slug": "outline",
          "color": "#afb3aa",
          "name": "Outline"
        },
        {
          "slug": "badge",
          "color": "#e5f4c9",
          "name": "Badge"
        }
      ]
    },
    "custom": {
      "flow-space": "clamp(1rem, 1.4vw, 1.4rem)",
      "focus-ring": "2px solid var(--wp--preset--color--accent)",
      "measure": "42rem",
      "shell": "72rem",
      "radius-card": "1.25rem",
      "radius-button": "0.5rem",
      "shadow-whisper": "0 20px 40px rgba(47, 52, 45, 0.04)",
      "glass-background": "rgba(250, 249, 244, 0.82)"
    },
    "layout": {
      "contentSize": "42rem",
      "wideSize": "72rem"
    },
    "spacing": {
      "blockGap": "clamp(1rem, 0.85rem + 0.8vw, 1.5rem)",
      "customSpacingSize": false,
      "spacingSizes": [
        {
          "slug": "2xs",
          "size": "clamp(0.375rem, 0.3rem + 0.2vw, 0.5rem)",
          "name": "2XS"
        },
        {
          "slug": "xs",
          "size": "clamp(0.5rem, 0.4rem + 0.35vw, 0.75rem)",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "clamp(0.75rem, 0.65rem + 0.45vw, 1rem)",
          "name": "SM"
        },
        {
          "slug": "md",
          "size": "clamp(1rem, 0.85rem + 0.8vw, 1.5rem)",
          "name": "MD"
        },
        {
          "slug": "lg",
          "size": "clamp(1.5rem, 1.25rem + 1.4vw, 2.5rem)",
          "name": "LG"
        },
        {
          "slug": "xl",
          "size": "clamp(2.5rem, 2rem + 2vw, 4rem)",
          "name": "XL"
        },
        {
          "slug": "2xl",
          "size": "clamp(4rem, 3.1rem + 4vw, 6rem)",
          "name": "2XL"
        }
      ],
      "units": [
        "px",
        "rem",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "Editorial Sans",
          "slug": "editorial-sans"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "SM"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "md",
          "size": "clamp(1.125rem, 1rem + 0.35vw, 1.25rem)",
          "name": "MD"
        },
        {
          "slug": "lg",
          "size": "clamp(1.5rem, 1.2rem + 1vw, 2rem)",
          "name": "LG"
        },
        {
          "slug": "xl",
          "size": "clamp(2rem, 1.6rem + 1.8vw, 3rem)",
          "name": "XL"
        },
        {
          "slug": "display",
          "size": "clamp(3rem, 2.2rem + 3.8vw, 5rem)",
          "name": "Display"
        }
      ],
      "lineHeight": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var:preset|color|background",
      "text": "var:preset|color|text"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|md",
      "padding": {
        "top": "var:preset|spacing|md",
        "right": "var:preset|spacing|md",
        "bottom": "var:preset|spacing|md",
        "left": "var:preset|spacing|md"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|editorial-sans",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "1.65"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "var(--wp--custom--radius-button)"
        },
        "color": {
          "background": "var:preset|color|accent",
          "text": "var:preset|color|background"
        },
        "spacing": {
          "padding": {
            "top": "0.75rem",
            "right": "1.125rem",
            "bottom": "0.75rem",
            "left": "1.125rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|editorial-sans",
          "fontSize": "var:preset|font-size|sm",
          "fontWeight": "600",
          "letterSpacing": "0.02em"
        }
      },
      "heading": {
        "color": {
          "text": "var:preset|color|text"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|editorial-sans",
          "fontWeight": "700",
          "letterSpacing": "-0.03em",
          "lineHeight": "0.96"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        },
        "typography": {
          "textDecoration": "underline"
        }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": {
          "fontSize": "var:preset|font-size|sm",
          "fontWeight": "500"
        }
      },
      "core/post-date": {
        "color": {
          "text": "var:preset|color|muted"
        },
        "typography": {
          "fontSize": "var:preset|font-size|xs",
          "letterSpacing": "0.04em",
          "textTransform": "uppercase"
        }
      },
      "core/post-terms": {
        "color": {
          "text": "var:preset|color|accent"
        },
        "typography": {
          "fontSize": "var:preset|font-size|xs",
          "fontWeight": "600",
          "letterSpacing": "0.08em",
          "textTransform": "uppercase"
        }
      },
      "core/site-title": {
        "typography": {
          "fontSize": "var:preset|font-size|sm",
          "fontWeight": "700",
          "letterSpacing": "-0.02em"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
