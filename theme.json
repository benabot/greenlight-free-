{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "color": {
      "custom": false,
      "customDuotone": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette": [
        {
          "slug": "base",
          "color": "#fcfcfa",
          "name": "Base"
        },
        {
          "slug": "surface",
          "color": "#e9ece3",
          "name": "Surface"
        },
        {
          "slug": "contrast",
          "color": "#1b1f18",
          "name": "Contrast"
        },
        {
          "slug": "accent",
          "color": "#0f6a51",
          "name": "Accent"
        }
      ]
    },
    "custom": {
      "flow-space": "clamp(1rem, 2vw, 1.5rem)",
      "focus-ring": "max(2px, 0.08em) solid currentColor",
      "measure": "68ch"
    },
    "layout": {
      "contentSize": "42rem",
      "wideSize": "68rem"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "customSpacingSize": false,
      "spacingSizes": [
        {
          "slug": "xs",
          "size": "0.5rem",
          "name": "XS"
        },
        {
          "slug": "s",
          "size": "0.75rem",
          "name": "S"
        },
        {
          "slug": "m",
          "size": "1.5rem",
          "name": "M"
        },
        {
          "slug": "l",
          "size": "3rem",
          "name": "L"
        }
      ],
      "units": [
        "px",
        "rem",
        "%",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
          "name": "System Sans",
          "slug": "system-sans"
        },
        {
          "fontFamily": "Iowan Old Style, Georgia, serif",
          "name": "System Serif",
          "slug": "system-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "Small"
        },
        {
          "slug": "base",
          "size": "1rem",
          "name": "Base"
        },
        {
          "slug": "lg",
          "size": "1.25rem",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "clamp(1.8rem, 4vw, 3rem)",
          "name": "XL"
        }
      ],
      "lineHeight": true
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var:preset|color|base",
      "text": "var:preset|color|contrast"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|m",
      "padding": {
        "top": "var:preset|spacing|m",
        "right": "var:preset|spacing|m",
        "bottom": "var:preset|spacing|m",
        "left": "var:preset|spacing|m"
      }
    },
    "typography": {
      "fontFamily": "var:preset|font-family|system-sans",
      "fontSize": "var:preset|font-size|base",
      "lineHeight": "1.6"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "var:preset|color|contrast",
          "text": "var:preset|color|base"
        },
        "spacing": {
          "padding": {
            "top": "0.625rem",
            "right": "1rem",
            "bottom": "0.625rem",
            "left": "1rem"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|system-sans",
          "fontWeight": "600"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|system-serif",
          "lineHeight": "1.2",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|accent"
        },
        "typography": {
          "textDecoration": "underline"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}
